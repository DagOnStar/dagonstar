     i=$((i+1))
@@ -903,6 +914,15 @@ then
         # echo ${HERCULES_ALLOC_DATA_HOSTFILE}
         # echo ${MALLEABILITY}
         tail -n +$((HERCULES_NUM_METADATA+1)) "${FULL_HOSTFILE}" | head -n "${HERCULES_NUM_DATA}" > "${HERCULES_DATA_HOSTFILE}"
+        ## Too few nodes after the metadata nodes (e.g., a one-node allocation):
+        ## complete the list with the other allocated nodes, one data server each.
+        if [[ $(wc -l < "${HERCULES_DATA_HOSTFILE}") -lt "${HERCULES_NUM_DATA}" ]]; then
+            awk -v n="${HERCULES_NUM_DATA}" "FILENAME==ARGV[1]{seen[\$0]=1; c++; next} c<n && !(\$0 in seen){print; seen[\$0]=1; c++}" "${HERCULES_DATA_HOSTFILE}" "${FULL_HOSTFILE}" >> "${HERCULES_DATA_HOSTFILE}"

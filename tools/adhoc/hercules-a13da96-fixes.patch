+        cp "${DATA_SERVER_FILE}" "${HERCULES_DATA_HOSTFILE}"
     fi
 
     set -x
@@ -825,6 +832,10 @@ else
     ## determinate set of metadata servers.
     echo "[+] Reading metadata server file - $META_SERVER_FILE"
     readarray -t meta_hosts < "$META_SERVER_FILE"
+    ## The configuration names HERCULES_METADATA_HOSTFILE: keep it in step.

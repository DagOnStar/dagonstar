+        if [[ $(wc -l < "${HERCULES_DATA_HOSTFILE}") -lt "${HERCULES_NUM_DATA}" ]]; then
+            echo "[Error] NUM_DATA_SERVERS=${HERCULES_NUM_DATA} needs at least that many allocated nodes."

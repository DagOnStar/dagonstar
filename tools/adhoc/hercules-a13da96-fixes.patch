+            srun --overlap -N 1 -n 1 -c 1 -m block:block:block --mem=1G -w $node -- $RM 2> /dev/null
             ## If slurm is being used, the service is deploy using srun.
             if [[ "${VERBOSE}" -eq "1" ]]; then
                 echo "[+] Starting data server $REAL_ID on $node..."
             fi
             #srun --exclusive -N 1 -n 1 -c 1 -m block:block:block --mem=0 -w $node -- $COMMAND &
-            srun  -N 1 -n 1 --cpus-per-task=4 -w $node -- $COMMAND &

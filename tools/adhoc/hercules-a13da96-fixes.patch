diff --git a/fuse/imss_posix_api.c b/fuse/imss_posix_api.c
index c7f7193..fa9ca04 100644
--- a/fuse/imss_posix_api.c
+++ b/fuse/imss_posix_api.c
@@ -802,6 +802,15 @@ extern "C"
 			return 0;
 		}
 
+		// POSIX read semantics: never transfer data past the end of the file.
+		// The per-block logic below clamps only the first block, so a request
+		// spanning several blocks would otherwise return bytes beyond EOF.
+		if ((size_t)offset + size > (size_t)stats.st_size)
+		{
+			size = (size_t)stats.st_size - (size_t)offset;
+			end_blk = ceil((double)(offset + size) / IMSS_DATA_BSIZE);
+		}
+
 		i_blk = 0;
 		while (curr_blk <= end_blk)
 		{
@@ -826,6 +835,10 @@ extern "C"
 						to_read = IMSS_DATA_BSIZE - start_offset;
 					}
 				}
+				if ((size_t)to_read > size)
+				{
+					to_read = size;
+				}
 				slog_debug("[imss_read] FIRST BLOCK CASE, to_read=%ld, fd=%d, ds=%d", to_read, fd, ds);
 
 				++first;
diff --git a/scripts/check-servers.sh b/scripts/check-servers.sh
index 826e45d..47fc0d4 100755
--- a/scripts/check-servers.sh
+++ b/scripts/check-servers.sh
@@ -45,10 +45,19 @@ echo ${HERCULES_PATH}
 CheckForStatusFile
 # echo $STATUS > file-status.out
 #echo "STATUS=$STATUS" >> ${HERCULES_PATH}/tmp/$SERVER_TYPE-hercules-$SERVER_NUMBER-$ACTION
-# If the server is locked we will wait until it is unlocked.
-until [ "$STATUS" != "LOCKED" ]; do
-    echo "[+][$HOSTNAME] Server $SERVER_NUMBER is locked, $STATUS"
-    CheckForStatusFile
+# Wait while the server is locked. The server rewrites the status file in
+# place (fopen "w+"), so an empty status means it is being written: wait too.
+polls=0
+until [ "$STATUS" = "OK" ] || [ "$STATUS" = "ERROR" ]; do
+    polls=$((polls + 1))
+    if [ $polls -gt $((ATTEMPS * 5)) ]; then
+        exit 1
+    fi
+    if [ $((polls % 25)) -eq 1 ]; then
+        echo "[+][$HOSTNAME] Server $SERVER_NUMBER status: ${STATUS:-<being written>}"
+    fi
+    sleep 0.2
+    CheckForStatusFile > /dev/null
 done
 
 

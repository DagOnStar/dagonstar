+    ## The configuration and the index below use HERCULES_DATA_HOSTFILE.
+    if [[ -n "${HERCULES_DATA_HOSTFILE}" && "${DATA_SERVER_FILE}" != "${HERCULES_DATA_HOSTFILE}" ]]; then
